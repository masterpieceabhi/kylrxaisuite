# Settings for one Onn HR server. A value with spaces or quotes in it goes inside single quotes. deploy/setup-server.sh copies this to /etc/onnhr/onnhr.env and fills in the four
# secret keys. Fill in the rest by hand on the server (sudo nano /etc/onnhr/onnhr.env). Never put real values in this
# template or anywhere in the code folder. Check with:  cd /srv/onnhr/app && sudo -u onnhr bash -c 'set -a; . /etc/onnhr/onnhr.env; npm run check:production'

NODE_ENV=production
PORT=3000
# the address people use; links in emails point here
APP_URL=https://app-staging.onnhr.com
ALLOWED_ORIGINS=https://app-staging.onnhr.com
# this server holds US companies only; a company of another country is sent to its own server
SERVED_COUNTRIES=US

# ---- made by setup-server.sh (do not change once people are using the server)
JWT_SECRET=
REFRESH_SECRET=
PII_ENCRYPTION_KEY=
AUDIT_CHAIN_KEY=

# ---- Firebase (Prompt AI's own project; docs/DEPLOY_GOOGLE.md step 2)
# the service account key file, uploaded to the server and readable by onnhr only
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/onnhr/firebase-key.json
FIREBASE_STORAGE_BUCKET=
# the web app settings from the Firebase console, as ONE line of JSON inside single quotes (the server reads this
# file as shell settings, which would strip the JSON's own quotes), for example
# FIREBASE_WEB_CONFIG='{"apiKey":"...","projectId":"onnhr-staging","storageBucket":"...","messagingSenderId":"...","appId":"..."}'
FIREBASE_WEB_CONFIG=

# ---- folders (made by setup-server.sh)
VAULT_DIR=/srv/onnhr/vault
BACKUP_DIR=/srv/onnhr/backups
LOG_DIR=/srv/onnhr/logs

# ---- email (Resend, domain onnhr.com verified; docs/DEPLOY_GOOGLE.md step 4)
RESEND_API_KEY=
EMAIL_FROM=no-reply@onnhr.com
EMAIL_SENDER_NAME='Onn HR'

# ---- daily housekeeping: leave RETENTION_AUTO unset until the retention periods are confirmed
# RETENTION_AUTO=on
BACKUP_KEEP_DAYS=35

# ---- Gusto (demo first; production only after Gusto approves)
GUSTO_INTEGRATION=app
GUSTO_MODE=demo
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
GUSTO_REDIRECT_URI=https://app-staging.onnhr.com/api/us/gusto/oauth/callback

# ---- sign-in: people use a PIN, a code or a QR
PASSWORD_SIGNIN=off

# ---- optional
# MONITORING_TOKEN=
# SENTRY_DSN=
