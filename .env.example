PORT=3000
NODE_ENV=development
EMAIL_SENDER_NAME=Kylrx HRFlow
SMTP_USER=info.kylrxai@gmail.com
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# ==============================================================================
# SENSITIVE CREDENTIALS: Store ONLY in host environment variables (system/cloud host)
# NEVER commit or store actual values in project files, repositories, or zip archives!
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"kylrxai",...}'
# SMTP_PASS=your_16_char_gmail_app_password
# RESEND_API_KEY=re_your_regenerated_resend_api_key

# Multi-tenant read isolation (turn on after scripts/migrate-tenant-orgid.js --apply)
TENANT_READ_SCOPING=off
# Firebase Admin service-account key file (alternative to FIREBASE_SERVICE_ACCOUNT)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Automation Builder AI (ChatGPT). Without a key the builder uses the rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# HR assistant (admin-us-assistant.html) uses the same key. Questions per company per day; 0 switches it off (default 200)
ASSISTANT_DAILY_LIMIT=200
# Local tests only: a stand-in for the OpenAI address (ignored when NODE_ENV=production)
# OPENAI_BASE_URL=http://127.0.0.1:4020/v1

# ==============================================================================
# PRODUCTION: the full list, what each one is for and which are required, is in docs/DEPLOY.md.
# Set these in the host's environment, not in a file. Check them with: npm run check:production
# ==============================================================================
# NODE_ENV=production
# PII_ENCRYPTION_KEY=          32 random bytes as base64. Losing it makes stored SSNs and bank numbers unreadable.
# AUDIT_CHAIN_KEY=             long random text for the audit-log integrity check
# VAULT_DIR=                   folder for employee documents, outside the app folder, on a disk that is backed up
# LOG_DIR=                     folder for error logs, outside the app folder
# MONITORING_TOKEN=            lets a monitoring service read /api/health/deep and /api/metrics
# PLATFORM_OPERATOR_TOKEN=     operator-only endpoints
# SENTRY_DSN=                  optional error reporting
# ALERT_EMAIL_TO=              who is emailed when the health check fails twice, server errors burst, or the daily run
#                              fails or stops (comma-separated). Unset: alerts are only logged. ALERTS=off stops the checks
# ALERT_COOLDOWN_MINUTES=60  ALERT_5XX_COUNT=20  ALERT_CHECK_MINUTES=5   alert tuning (see services/ops-alerts.js)
# GUSTO_CLIENT_ID=  GUSTO_CLIENT_SECRET=  GUSTO_MODE=demo      payroll through Gusto (mock is refused in production)
# GUSTO_INTEGRATION=app        app = each customer connects their own Gusto account (payroll is run in Gusto);
#                              embedded (default) = Gusto Embedded Payroll, we create the company and run payroll here
# GUSTO_REDIRECT_URI=          where Gusto sends the owner back; must match an address registered at dev.gusto.com exactly.
#                              Default http://localhost:<PORT>/api/us/gusto/oauth/callback. Production: https://app.onnhr.com/api/us/gusto/oauth/callback
# STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=                   billing
# ALLOWED_ORIGINS=             exact web addresses of a client app that may call this API from a browser, comma-separated,
#                              for example https://app.onnhr.com,https://staging.onnhr.com (no paths, no wildcards)

# Sign-in with a PIN, and a code by email as the way back in (routes/pin-signin.js).
# The code goes out through the app's one email sender: SMTP_USER and SMTP_PASS (Gmail, or any mail server when
# SMTP_HOST and SMTP_PORT are set, for example smtp.office365.com and 587), or RESEND_API_KEY. EMAIL_FROM and
# EMAIL_SENDER_NAME set the sender shown. Without email the code is not sent: a development server then shows it on
# the sign-in page; a production server never does.
# SMTP_HOST=
# SMTP_PORT=587
# EMAIL_FROM=
# EMAIL_SENDER_NAME=Onn HR

# Sign-in codes by text message (the person chooses email or text after a wrong PIN). A text goes only to the mobile
# number already on the person's record. Without these three, no text is sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# PASSWORD_SIGNIN=off refuses password sign-in at /api/auth/login (people use a PIN, a code or a QR). Email-and-password
# sign-in must ALSO be switched off in the Firebase console (Authentication > Sign-in method), because the browser can
# reach Firebase directly. Leave unset while the demo buttons or the local end-to-end run are in use.
# PASSWORD_SIGNIN=off

# The once-a-day housekeeping run (services/daily-jobs.js). It claims each day in the database, so it runs once.
# RETENTION_AUTO=on really deletes what has passed its retention date. Unset, it only counts what it would delete.
# BACKUP_DIR is where a dated backup folder is written each day; folders older than BACKUP_KEEP_DAYS are removed
# (the newest is always kept). A backup on the same disk as the app does not survive losing that disk: copy the
# folder off the server, or use Google's scheduled Firestore backups as well (docs/BACKUP.md).
# RETENTION_AUTO=on
# BACKUP_DIR=
# BACKUP_KEEP_DAYS=35
# DAILY_JOBS_HOUR_UTC=8
# DAILY_JOBS=off

# Email notices (services/email-notices.js): hours and time off waiting for a decision, decisions, announcements and
# policies. They go out through the same email settings as everything else, only when email is set up. NOTICES_EMAIL=off
# stops them for the whole server; a company stops them with noticesEmail: false on its organization record.
# NOTICES_EMAIL=off
# Once a day (with the daily run) reminder emails go out: open onboarding/offboarding tasks, policies not yet
# confirmed, documents not yet signed (with a fresh signing link). REMINDERS_EMAIL=off stops only these.
# REMINDERS_EMAIL=off

# Which countries this server takes (services/served-countries.js). Not set: every country, in one database.
# SERVED_COUNTRIES=US           IN, US, CA, comma-separated. A company of another country is turned away at sign-up.
# COUNTRY_ADDRESSES=US=https://us.onnhr.com,IN=https://in.onnhr.com   where each country signs up, so a refusal can say where to go

# ---------------------------------------------------------------------------------------------------------------
# Other settings the server reads. All are optional; the value shown is what is used when the line is left out.
# (Listed on 2026-11-19 by searching the code for process.env; tests/env-documented.test.mjs fails when a new one is
# read by the server and not mentioned in this file.)
# ---------------------------------------------------------------------------------------------------------------

# Addresses and identity
# APP_URL=https://app.onnhr.com          the address people open, put into links in emails. Without it links point at a developer PC.
# FIREBASE_WEB_CONFIG=                   the web app settings of this server's own Firebase project, as one line of JSON; the pages ask the server for it
# FIREBASE_PROJECT_ID=                   only with the local emulators: which pretend project to use (default kylrxai)
# FIREBASE_STORAGE_BUCKET=               the storage bucket of the Firebase project (default kylrxai.firebasestorage.app)
# BUILD_ID=                              the release this server runs (a commit id), shown by /api/status. GIT_SHA is read when BUILD_ID is not set.

# Background jobs. One copy of the server runs each job (services/job-lock.js), so two copies are safe.
# JOB_LOCKS=off                          every copy runs every job, as before the leases existed
# INTEGRATION_WORKERS=off                do not start outgoing webhooks and connector schedules on this server
# WEBHOOK_TICK_MS=5000                   how often outgoing webhooks are sent
# CONNECTOR_TICK_MS=60000                how often connector schedules are looked at
# COMP_HISTORY_JOB=off                   do not apply pay changes on their effective date by themselves
# DISABLE_PHOTO_PURGE_JOB=1              do not remove clock photos that have passed their keep time
# GUSTO_POLL_JOB=on                      ask Gusto for events on a timer (off unless set; webhooks are the usual way)

# Limits
# API_RATE_LIMIT=2000                    requests per network address in 15 minutes. A workplace often shares one address; raise it for a large site (100 or more).
# API_ORG_RATE_LIMIT_PER_MINUTE=3000     requests per company a minute on the public API (/api/v1)
# PUBLIC_APPLY_MAX=5                     job applications per address in PUBLIC_APPLY_WINDOW_MS (default one hour)
# PUBLIC_READ_MAX=120                    reads of the public careers pages per address in PUBLIC_READ_WINDOW_MS (default ten minutes)
# PUBLIC_SIGN_MAX=60                     signing-page requests per address in ten minutes
# PUBLIC_BADTOKEN_MAX=10                 wrong signing or apply links per address in 15 minutes

# Webhooks and files
# WEBHOOK_LOG_RETENTION_DAYS=180         how long the record of sent webhooks is kept
# WEBHOOK_BACKOFF_SCALE=1                multiplies the wait between retries (tests use a small number)
# WEBHOOK_ALLOW_LOOPBACK=true            let a webhook address point at this machine. Never honoured in production.
# CONNECTOR_EXPORT_DIR=                  where file-export connectors write (default data/exports inside the app folder; in a container point it at /data/exports)

# Platform staff and logs
# PLATFORM_ORG_ID=                       the company id of the platform operator's own staff
# PLATFORM_SUPPORT_EMAILS=               comma-separated emails that may ask a customer for read-only support access
# BILLING_PROVIDER=stripe                real card billing (default mock: practice mode, nobody is charged)
# REQUEST_LOG=off                        do not write a line for every request

# Leave these out on a real server
# ALLOW_DEV_AUTH=true                    local shortcuts for signing in. Refused in production.
# DEV_DEFAULT_ORG_ID=                    the company used for an account with none, in local development (default org_kylrx_ai)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 the local database emulator. A real server must not set it.

# India payroll only
# KYLRX_EXPORT_SIGNING_KEY=              signs exported payroll files. Without it a key that is written in the source code is used.
# DECENTRO_BASE_URL=  DECENTRO_CLIENT_ID=  DECENTRO_CLIENT_SECRET=  DECENTRO_MODULE_SECRET=  DECENTRO_PROVIDER_SECRET=    bank transfers through Decentro

# Billing
# BILLING_ENFORCE=on                     a company whose subscription is suspended or cancelled becomes read-only: it can still read,
#                                        clock in, pay its bill and use its privacy rights. Not set: nothing is held back.
