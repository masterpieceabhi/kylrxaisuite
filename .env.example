PORT=3000
NODE_ENV=development
EMAIL_SENDER_NAME=Kylrx HRFlow
SMTP_USER=info.kylrxai@gmail.com
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# ==============================================================================
# SENSITIVE CREDENTIALS: Store ONLY in host environment variables (system/cloud host)
# NEVER commit or store actual values in project files, repositories, or zip archives!
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"kylrxai",...}'
# SMTP_PASS=your_16_char_gmail_app_password
# RESEND_API_KEY=re_your_regenerated_resend_api_key

# Multi-tenant read isolation (turn on after scripts/migrate-tenant-orgid.js --apply)
TENANT_READ_SCOPING=off
# Firebase Admin service-account key file (alternative to FIREBASE_SERVICE_ACCOUNT)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Automation Builder AI (ChatGPT). Without a key the builder uses the rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# PRODUCTION: the full list, what each one is for and which are required, is in docs/DEPLOY.md.
# Set these in the host's environment, not in a file. Check them with: npm run check:production
# ==============================================================================
# NODE_ENV=production
# PII_ENCRYPTION_KEY=          32 random bytes as base64. Losing it makes stored SSNs and bank numbers unreadable.
# AUDIT_CHAIN_KEY=             long random text for the audit-log integrity check
# VAULT_DIR=                   folder for employee documents, outside the app folder, on a disk that is backed up
# LOG_DIR=                     folder for error logs, outside the app folder
# MONITORING_TOKEN=            lets a monitoring service read /api/health/deep and /api/metrics
# PLATFORM_OPERATOR_TOKEN=     operator-only endpoints
# SENTRY_DSN=                  optional error reporting
# GUSTO_CLIENT_ID=  GUSTO_CLIENT_SECRET=  GUSTO_MODE=demo      payroll through Gusto (mock is refused in production)
# GUSTO_INTEGRATION=app        app = each customer connects their own Gusto account (payroll is run in Gusto);
#                              embedded (default) = Gusto Embedded Payroll, we create the company and run payroll here
# GUSTO_REDIRECT_URI=          where Gusto sends the owner back; must match an address registered at dev.gusto.com exactly.
#                              Default http://localhost:<PORT>/api/us/gusto/oauth/callback. Production: https://app.onnhr.com/api/us/gusto/oauth/callback
# STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=                   billing
# ALLOWED_ORIGINS=             exact web addresses of a client app that may call this API from a browser, comma-separated,
#                              for example https://app.onnhr.com,https://staging.onnhr.com (no paths, no wildcards)

# Sign-in with a PIN, and a code by email as the way back in (routes/pin-signin.js).
# The code goes out through the app's one email sender: SMTP_USER and SMTP_PASS (Gmail, or any mail server when
# SMTP_HOST and SMTP_PORT are set, for example smtp.office365.com and 587), or RESEND_API_KEY. EMAIL_FROM and
# EMAIL_SENDER_NAME set the sender shown. Without email the code is not sent: a development server then shows it on
# the sign-in page; a production server never does.
# SMTP_HOST=
# SMTP_PORT=587
# EMAIL_FROM=
# EMAIL_SENDER_NAME=Onn HR

# Sign-in codes by text message (the person chooses email or text after a wrong PIN). A text goes only to the mobile
# number already on the person's record. Without these three, no text is sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# PASSWORD_SIGNIN=off refuses password sign-in at /api/auth/login (people use a PIN, a code or a QR). Email-and-password
# sign-in must ALSO be switched off in the Firebase console (Authentication > Sign-in method), because the browser can
# reach Firebase directly. Leave unset while the demo buttons or the local end-to-end run are in use.
# PASSWORD_SIGNIN=off

# The once-a-day housekeeping run (services/daily-jobs.js). It claims each day in the database, so it runs once.
# RETENTION_AUTO=on really deletes what has passed its retention date. Unset, it only counts what it would delete.
# BACKUP_DIR is where a dated backup folder is written each day; folders older than BACKUP_KEEP_DAYS are removed
# (the newest is always kept). A backup on the same disk as the app does not survive losing that disk: copy the
# folder off the server, or use Google's scheduled Firestore backups as well (docs/BACKUP.md).
# RETENTION_AUTO=on
# BACKUP_DIR=
# BACKUP_KEEP_DAYS=35
# DAILY_JOBS_HOUR_UTC=8
# DAILY_JOBS=off

# Email notices (services/email-notices.js): hours and time off waiting for a decision, decisions, announcements and
# policies. They go out through the same email settings as everything else, only when email is set up. NOTICES_EMAIL=off
# stops them for the whole server; a company stops them with noticesEmail: false on its organization record.
# NOTICES_EMAIL=off
