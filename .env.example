PORT=3000
NODE_ENV=development
EMAIL_SENDER_NAME=Kylrx HRFlow
SMTP_USER=info.kylrxai@gmail.com
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# ==============================================================================
# SENSITIVE CREDENTIALS: Store ONLY in host environment variables (system/cloud host)
# NEVER commit or store actual values in project files, repositories, or zip archives!
# ==============================================================================
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"kylrxai",...}'
# SMTP_PASS=your_16_char_gmail_app_password
# RESEND_API_KEY=re_your_regenerated_resend_api_key

# Multi-tenant read isolation (turn on after scripts/migrate-tenant-orgid.js --apply)
TENANT_READ_SCOPING=off
# Firebase Admin service-account key file (alternative to FIREBASE_SERVICE_ACCOUNT)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Automation Builder AI (ChatGPT). Without a key the builder uses the rule-based fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# PRODUCTION: the full list, what each one is for and which are required, is in docs/DEPLOY.md.
# Set these in the host's environment, not in a file. Check them with: npm run check:production
# ==============================================================================
# NODE_ENV=production
# PII_ENCRYPTION_KEY=          32 random bytes as base64. Losing it makes stored SSNs and bank numbers unreadable.
# AUDIT_CHAIN_KEY=             long random text for the audit-log integrity check
# VAULT_DIR=                   folder for employee documents, outside the app folder, on a disk that is backed up
# LOG_DIR=                     folder for error logs, outside the app folder
# MONITORING_TOKEN=            lets a monitoring service read /api/health/deep and /api/metrics
# PLATFORM_OPERATOR_TOKEN=     operator-only endpoints
# SENTRY_DSN=                  optional error reporting
# GUSTO_CLIENT_ID=  GUSTO_CLIENT_SECRET=  GUSTO_MODE=demo      payroll through Gusto (mock is refused in production)
# STRIPE_SECRET_KEY=  STRIPE_WEBHOOK_SECRET=                   billing
